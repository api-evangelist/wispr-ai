        {
          "info": {
            "name": "List Events",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/analytics-registry/events",
            "auth": {
              "type": "apikey",
              "key": "Authorization",
