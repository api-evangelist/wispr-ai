          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/analytics-registry/events",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Batch Save Events"
        },
        {
          "info": {
