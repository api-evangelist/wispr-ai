        {
          "id": "61758389-679b-4565-98db-e28ffb316c4f",
          "name": "Get Events Batch",
          "request": {
            "name": "Get Events Batch",
            "description": {
              "content": "Return the authenticated user's calendar events matching the given externalIds.\n\nDesigned for the desktop to re-fetch events linked to past notes whose local\ncalendar cache was pruned. No ``start_at_utc`` filter — past events are returned.\nCancelled events are included so the desktop can render the correct state.\nA stranger's ``externalId`` matches no row (query is ``user_id``-scoped).\nEvent order is unspecified; callers look events up by ``externalId``.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "calendar",
                "events",
                "batch"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "ids",
                  "value": "<string>",
                  "description": "(Required) Comma-separated calendar ``externalId`` values to look up. At most 50 per request; missing ids are absent from the response."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "apikey",
              "apikey": [
