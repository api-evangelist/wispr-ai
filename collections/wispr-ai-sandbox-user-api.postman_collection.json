        {
          "id": "678999f7-c846-40bc-8466-363528457ba6",
          "name": "Destroy a sandbox user",
          "request": {
            "name": "Destroy a sandbox user",
            "description": {
              "content": "Destroy a sandbox user by deleting all associated data from all tables and services.\n    This endpoint:\n    1. Validates the user has a @wispr.test email\n    2. Checks if user is the only member of an enterprise and deletes the enterprise if so\n    3. Uses the existing compliance-ready user deletion service\n    4. Deletes data from: main DB (incl. Subscription via CASCADE), usage DB, Customer.io, Segment, PostHog, ClickHouse\n    5. Cancels any active subscriptions via Stripe\n    6. Deletes from Supabase Auth\n    **WARNING**: This permanently deletes all data for the sandbox user and their enterprise if they're the only member.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "sandbox-user",
                "destroy"
              ],
              "host": [
                "{{baseUrl}}"
              ],
