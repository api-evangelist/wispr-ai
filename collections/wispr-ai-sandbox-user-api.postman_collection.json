          "name": "Create and sign in a sandbox user",
          "request": {
            "name": "Create and sign in a sandbox user",
            "description": {
              "content": "Create a sandbox user and sign in.\n    **Authentication Required**: Must be logged in with a @wispr.ai email address.\n    This endpoint:\n    1. Creates a Supabase user with @wispr.test email\n    2. Creates all necessary database records with onboarding NOT completed\n    3. Returns auth tokens for immediate sign-in",
              "type": "text/plain"
            },
