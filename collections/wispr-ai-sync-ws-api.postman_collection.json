          "name": "Admin Test Publish",
          "request": {
            "name": "Admin Test Publish",
            "description": {
              "content": "Synthesize one or more sync events for ``user_id``.\n\n``burst > 1`` is the gap-too-large drill: publishing more than the replay\nbuffer size (``publisher.REPLAY_MAXLEN``) forces the oldest entries out so\na reconnecting client with a stale ``since`` falls through to\n``/sync/check``.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "sync",
                "ws",
                "admin",
                "test-publish"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "burst",
                  "value": "1"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "Authorization"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"<string>\",\n  \"event_type\": \"<string>\",\n  \"reason\": \"<string>\",\n  \"options\": {\n    \"meeting_id\": \"<uuid>\"\n  }\n}",
