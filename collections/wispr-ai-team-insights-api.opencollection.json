        },
        {
          "info": {
            "name": "Get Impact",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/enterprise/insights/impact",
            "params": [
              {
                "name": "enterprise_id",
                "value": "",
                "type": "query",
                "description": "Enterprise to query. Wispr admins may pass any; enterprise admins must pass their own."
              },
              {
                "name": "team_id",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "All Impact cards in one round trip. ``team_id`` is the only filter."
        },
        {
          "info": {
            "name": "List Filter Options",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/enterprise/insights/filter-options",
            "params": [
              {
                "name": "enterprise_id",
                "value": "",
                "type": "query",
                "description": "Enterprise to query. Wispr admins may pass any; enterprise admins must pass their own."
