          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/enterprise/insights/desktop-apps",
            "params": [
              {
                "name": "enterprise_id",
                "value": "",
                "type": "query",
                "description": "Enterprise to query. Wispr admins may pass any; enterprise admins must pass their own."
              },
              {
                "name": "start_date",
                "value": "",
                "type": "query"
              },
              {
                "name": "end_date",
                "value": "",
                "type": "query"
              },
              {
                "name": "team_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "user_ids",
                "value": "",
                "type": "query"
              },
              {
                "name": "app_keys",
                "value": "",
                "type": "query"
              },
              {
                "name": "app_categories",
                "value": "",
