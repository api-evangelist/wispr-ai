          "name": "Sync Todos",
          "request": {
            "name": "Sync Todos",
            "description": {
              "content": "Bidirectionally sync the user's todos (whole-row, LWW on ``modified_at``).\n\nIngest is INSERT-adopt with guards: a pushed id that exists under another user,\nor whose non-null ``meeting_id`` isn't the caller's, is omitted from ``acked``\nso the client retries; everything else is created/updated. The pull carries\nevery todo the user owns (capped), including tombstones.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "todos",
                "sync"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
